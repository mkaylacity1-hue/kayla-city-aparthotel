# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings → API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used solely in server-side code that needs to bypass RLS
# (e.g. admin scripts). Never exposed to the browser, never prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
